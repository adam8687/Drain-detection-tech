HOST=0.0.0.0
PORT=8000
NODE_ENV=development
# Supabase is the source of truth. Apply the SQL migration before starting.
STORAGE_BACKEND=supabase
# SQLite is an explicit offline test option only; production requires Supabase.
SQLITE_PATH=./data/drain-monitor.sqlite
# Empty = unauthenticated LOCAL prototype. Set a long random token for team hosting.
# Clients then send Authorization: Bearer <API_KEY>. Never use a Supabase secret here.
API_KEY=
# Comma-separated frontend origins, or * for a development-only open API.
# LAN example: http://192.168.1.10:5173,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Used by npm run simulate (otherwise defaults to http://127.0.0.1:8000)
API_BASE_URL=http://127.0.0.1:8000

# Calibration now requires an explicit confirmed-empty recording.
# Optional simulation fixture ID:
MOCK_FIXTURE_ID=live-simulation

# Server-only owner alerts. Keep disabled until providers are configured.
DRAIN_APP_URL=https://drain-detection-tech.vercel.app
DRAIN_EMAIL_ENABLED=false
DRAIN_EMAIL_FROM=
RESEND_API_KEY=
# Server-only purpose-scoped retry-worker token; never supplied to a customer.
DRAIN_EMAIL_WORKER_TOKEN=
# Optional operator Management API credential for auth:setup --apply; not a Data API key.
SUPABASE_ACCESS_TOKEN=

# Twilio SMS: use an SMS-capable number OR a Messaging Service with a sender.
DRAIN_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
