{
  "openapi": "3.1.0",
  "info": {
    "title": "Drain Monitor records API",
    "version": "1.0.0",
    "description": "Single-table drain_records storage. All calibration, results and forecasts are calculated by the backend. Server Supabase credentials never belong in ESP32 or browser code."
  },
  "security": [
    {
      "backendToken": []
    }
  ],
  "paths": {
    "/api/v1/records": {
      "get": {
        "summary": "List recording summaries",
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        },
        "parameters": [
          {
            "name": "fixture_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "data_source",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "record_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "recording_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Start a recording. Calibration requires explicit empty confirmation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fixture_id",
                  "record_type",
                  "data_source"
                ],
                "additionalProperties": false,
                "properties": {
                  "fixture_id": {
                    "type": "string"
                  },
                  "record_type": {
                    "enum": [
                      "calibration",
                      "drainage",
                      "monitoring"
                    ]
                  },
                  "data_source": {
                    "enum": [
                      "sensor",
                      "simulation"
                    ]
                  },
                  "confirm_empty": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        }
      }
    },
    "/api/v1/records/{record_id}": {
      "get": {
        "summary": "Get a recording and backend-computed forecast/replay timeline",
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        },
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sample",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "window",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "description": "Return only the latest readings/graph points; original sample_count and elapsed timestamps remain unchanged."
          }
        ]
      }
    },
    "/api/v1/records/{record_id}/measurements": {
      "post": {
        "summary": "Append one reading; retry the identical reading_id/body safely",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reading_id",
                  "timestamp",
                  "sensor"
                ],
                "additionalProperties": false,
                "properties": {
                  "reading_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "sensor": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "distance_mm",
                          "status"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "distance_mm": {
                            "type": "number",
                            "minimum": 20,
                            "maximum": 4500
                          },
                          "status": {
                            "const": "ok"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "distance_mm",
                          "status"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "distance_mm": {
                            "type": "null"
                          },
                          "status": {
                            "enum": [
                              "timeout",
                              "out_of_range"
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        },
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/records/{record_id}/finish": {
      "post": {
        "summary": "Finish recording and persist backend result",
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        },
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/records/{record_id}/stream": {
      "get": {
        "summary": "Authenticated SSE snapshots of recording and backend computations",
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        },
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/records/{record_id}/drainage-calibration": {
      "post": {
        "summary": "Owner-only controlled drainage calibration; changes only existing calibration JSON, never sensor measurements or transmission.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "action",
                      "recording_id",
                      "confirm_tap_off",
                      "confirm_clear"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "action": {
                        "const": "start"
                      },
                      "recording_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "confirm_tap_off": {
                        "const": true
                      },
                      "confirm_clear": {
                        "const": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "action",
                      "capture_id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "action": {
                        "enum": [
                          "complete",
                          "cancel"
                        ]
                      },
                      "capture_id": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        },
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/alerts": {
      "get": {
        "summary": "List backend-derived alerts (slow drains, running too long, worsening trends, sensor faults, silent devices), most severe first",
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        },
        "parameters": [
          {
            "name": "fixture_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "data_source",
            "in": "query",
            "schema": {
              "enum": [
                "sensor",
                "simulation"
              ]
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "enum": [
                "critical",
                "warning",
                "info"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ]
      }
    },
    "/api/v1/sensor/active-record": {
      "get": {
        "summary": "Sensor-key-only discovery of its own active physical recording ID/type; no history or measurements",
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "summary": "List fixtures visible to the signed-in user",
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        }
      },
      "post": {
        "summary": "Register a fixture and assign its signed-in owner",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "device_id",
                  "name"
                ],
                "properties": {
                  "device_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        }
      }
    },
    "/api/v1/devices/{device_id}/keys": {
      "post": {
        "summary": "Owner-only sensor key issuance; full key is returned once",
        "responses": {
          "200": {
            "description": "Success; POST creation/append may return 201"
          },
          "401": {
            "description": "Backend token required"
          },
          "409": {
            "description": "Conflict, missing calibration, or finished recording"
          },
          "422": {
            "description": "Invalid measurement or record input"
          },
          "503": {
            "description": "Storage unavailable; no fallback"
          }
        },
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "backendToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Backend API_KEY for admin, Supabase access token for owner/viewer access, or fixture device key for physical measurement appends and own active-record discovery only."
      }
    },
    "schemas": {
      "Measurement": {
        "type": "object",
        "required": [
          "reading_id",
          "timestamp",
          "sensor"
        ],
        "additionalProperties": false,
        "properties": {
          "reading_id": {
            "type": "string",
            "format": "uuid"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "sensor": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "distance_mm",
                  "status"
                ],
                "additionalProperties": false,
                "properties": {
                  "distance_mm": {
                    "type": "number",
                    "minimum": 20,
                    "maximum": 4500
                  },
                  "status": {
                    "const": "ok"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "distance_mm",
                  "status"
                ],
                "additionalProperties": false,
                "properties": {
                  "distance_mm": {
                    "type": "null"
                  },
                  "status": {
                    "enum": [
                      "timeout",
                      "out_of_range"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
