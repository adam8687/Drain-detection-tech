{
  "name": "drain-monitor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "simulate": "node --env-file-if-exists=.env scripts/simulate.js",
    "check:supabase": "node --env-file-if-exists=.env scripts/check-supabase.js",
    "verify:supabase": "node --env-file-if-exists=.env scripts/verify-supabase.js",
    "check": "node --check src/server.js && node --check public/app.js && npm test",
    "seed:practice": "node --env-file-if-exists=.env scripts/seed-practice.js"
  }
}
