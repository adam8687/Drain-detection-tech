# Server-side backend URL used by the same-origin records gateway.
BACKEND_URL=http://127.0.0.1:8000
# Do not put Supabase secrets or backend tokens in NEXT_PUBLIC variables.
# Existing .env.local files are preserved; NEXT_PUBLIC_BACKEND_URL is unused.

# Optional browser sign-in; use a publishable key, never a server secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
