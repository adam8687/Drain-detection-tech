# Server-side backend URL used by the same-origin records gateway.
BACKEND_URL=http://127.0.0.1:8000
# Optional hosted API; cloud:start loads generated web/.env.cloud.local instead.
# Keep the function prefix: https://PROJECT.supabase.co/functions/v1/drain-api
SUPABASE_FUNCTION_URL=
# Optional server-only read-only fixture viewer. Never put an admin key here.
DRAIN_VIEWER_TOKEN=
# Do not put Supabase secrets or backend tokens in NEXT_PUBLIC variables.
# Existing .env.local files are preserved; NEXT_PUBLIC_BACKEND_URL is unused.

# Optional browser sign-in; use a publishable key, never a server secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
