# Browser-facing backend base URL; set to the backend's LAN/HTTPS URL when remote.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Server-side URL used only by the optional /api/events proxy.
BACKEND_URL=http://127.0.0.1:8000
# Supabase sign-in. Use the PUBLISHABLE key (sb_publishable_...), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Do not put the Supabase secret in this frontend. It belongs in backend/.env.
# The proxy forwards a caller-supplied Authorization header; it does not inject keys.
