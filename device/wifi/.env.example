# Private bench settings. Run npm run wifi:init, then edit device/wifi/.env.
# The ESP and this computer must share a reachable 2.4 GHz Wi-Fi network.
WIFI_SSID="YOUR_WIFI_NAME"
WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
# Set by cloud:configure for direct HTTPS uploads into Supabase.
CLOUD_API_URL=
API_ROOT_CA_FILE=device/wifi/data/supabase-root-ca.pem
# Optional: this computer's private IPv4 address. Auto-detects if unambiguous.
WIFI_HOST=
# API uses PORT from backend/.env (default 8000). Dashboard uses this port.
WEB_PORT=3000
# Explicit opt-in: HTTP carries the fixture key unencrypted on your test LAN.
ALLOW_LOCAL_HTTP=false
# Keep the sensor jumper removed for false, installed for true.
USE_UART=false
# One sensor initially. Enable after wiring B to D3 (Trig) and D2 (Echo).
SECOND_SENSOR_ENABLED=false
# Fresh board only. Formatting can destroy pending samples; normally false.
INITIALIZE_EMPTY_FILESYSTEM=false
