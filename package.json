{
  "name": "drain-detection-tech",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node backend/scripts/setup-env.js",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "check": "npm --prefix backend run check",
    "simulate": "npm --prefix backend run simulate --",
    "device:setup": "node --env-file-if-exists=backend/.env device/usb-bridge/setup.js",
    "device:ports": "node device/usb-bridge/run.js --ports",
    "device:upload": "node --env-file-if-exists=device/usb-bridge/.env device/usb-bridge/run.js",
    "device:verify": "node --env-file-if-exists=backend/.env device/usb-bridge/verify-cloud.js",
    "wifi:init": "node device/wifi/run.js init",
    "wifi:start": "node --env-file-if-exists=backend/.env device/wifi/run.js start",
    "wifi:check": "node --env-file-if-exists=backend/.env device/wifi/run.js check",
    "wifi:prepare": "node --env-file-if-exists=backend/.env device/wifi/run.js prepare",
    "wifi:watch": "node --env-file-if-exists=backend/.env device/wifi/run.js watch",
    "wifi:finish": "node --env-file-if-exists=backend/.env device/wifi/run.js finish",
    "cloud:deploy": "node --env-file-if-exists=backend/.env scripts/cloud.js deploy",
    "cloud:configure": "node --env-file-if-exists=backend/.env scripts/cloud.js configure",
    "cloud:start": "node scripts/cloud.js start",
    "cloud:check": "node --env-file-if-exists=backend/.env scripts/cloud.js check",
    "check:supabase": "npm --prefix backend run check:supabase",
    "verify:supabase": "npm --prefix backend run verify:supabase",
    "seed:practice": "npm --prefix backend run seed:practice",
    "migrate:records": "npm --prefix backend run migrate:records",
    "auth:setup": "node scripts/auth-setup.mjs",
    "email:retry": "node --env-file-if-exists=supabase/.env.cloud scripts/email-retry.mjs",
    "egress:estimate": "node scripts/egress-estimate.mjs"
  }
}
